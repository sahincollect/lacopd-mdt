# ─── Veritabanı (Supabase PostgreSQL) ─────────────────────────
# Supabase > Connect > ORMs (Prisma) / Session Pooler bağlantı URL'si:
DATABASE_URL="postgresql://postgres.[PROJE_REF]:[SIFRE]@aws-0-[BOLGE].pooler.supabase.com:5432/postgres"

# ─── JWT Güvenlik Anahtarı ────────────────────────────────────
# Uzun ve rastgele bir string olmalı. Örnek: openssl rand -hex 32
JWT_SECRET="BURAYA_GUCLU_BIR_SECRET_GIRIN"
